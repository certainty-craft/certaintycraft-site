# Per-path headers for Netlify.
# One stanza per landing-page slug, appended by the agent at publish time
# (daily-agent.md Step 5c). Landing pages are unlisted: noindex, nofollow,
# and never linked from site navigation. Do not remove stanzas while the
# matching application is open; see portfolio/landing/REGISTRY.md.

# --- Caching ---------------------------------------------------------------
# The runtime under /vendor is pinned (React 18.3.1) and only changes when it
# is replaced deliberately, so it can be cached hard. The design system lives
# in a content-hashed directory (a rebuild changes the path), so it can be
# cached hard too. Images get a month; they change rarely and a stale copy is
# cosmetic only. HTML must revalidate so a copy fix goes live on the next
# request rather than whenever a cache expires.

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/_ds/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=2592000

/assets/*
  Cache-Control: public, max-age=2592000

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The copy admin is an editing surface, never a search result.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
